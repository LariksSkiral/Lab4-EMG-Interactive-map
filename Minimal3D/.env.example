# Copy this file to .env and fill in your own Supabase details.
# This version is placed in Minimal3D so Vite can read it when using --root Minimal3D.

# Supabase Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase browser-safe key.
# You can use the new Publishable key here.
# The older anon key also works, but Publishable is the modern option.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Storage bucket for model uploads
VITE_SUPABASE_BUCKET=glb-models

# Optional subfolder inside bucket.
# Leave it empty if you want files stored directly in the bucket root.
VITE_SUPABASE_FOLDER=
