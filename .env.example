# Copy this file to .env and replace the values with your own Supabase project details.
# Beginner note: Vite reads variables that start with VITE_ and makes them available to the browser app.

# Your Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://hziltkgyworuslnpadmb.supabase.co

# Your browser-safe Supabase key.
# Use the new Publishable key if your project shows that instead of the legacy anon key.
VITE_SUPABASE_ANON_KEY=sb_publishable_s1XrmOzmECiC-Q4YqRp6wg_tipgegsE

# Name of the Storage bucket where .glb files will be stored
# Create this in Supabase: Storage -> New Bucket
VITE_SUPABASE_BUCKET=models

# Folder inside that bucket (helps keep files organized)
# Leave it empty if you want files in the bucket root.
VITE_SUPABASE_FOLDER=
